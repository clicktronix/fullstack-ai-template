{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "generatedRoot": "src/generated",
  "moduleRoot": "src/modules",
  "segments": ["domain", "application", "server", "client", "ui"],
  "publicSurfaces": ["server", "rsc", "actions", "client", "ui", "query-cache", "stream", "job"],
  "serverSurfaces": ["server", "rsc", "stream", "job"],
  "serverExecutionSurfaces": ["server", "rsc", "actions", "stream", "job"],
  "clientSurfaces": ["client", "ui"],
  "neutralSurfaces": ["query-cache"],
  "sharedRoots": ["kernel", "server", "client", "ui"],
  "purePackages": ["dayjs", "valibot"],
  "runtimePackages": [
    "next",
    "react",
    "react-dom",
    "server-only",
    "client-only",
    "@mantine",
    "@sentry",
    "@supabase",
    "@tabler",
    "@tanstack",
    "@vercel",
    "@prisma",
    "drizzle-orm",
    "next-safe-action",
    "pg",
    "pino",
    "postgres",
    "react-error-boundary",
    "react-intl",
    "recharts",
    "mysql2",
    "mongodb",
    "redis",
    "ioredis"
  ],
  "databaseResources": [
    { "kind": "table", "name": "users", "owner": "identity" },
    { "kind": "table", "name": "labels", "owner": "labels" },
    { "kind": "table", "name": "work_items", "owner": "work-items" },
    {
      "kind": "table",
      "name": "idempotency_keys",
      "owner": "shared/server"
    }
  ]
}
